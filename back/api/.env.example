# ---------- App ----------
NODE_ENV=production
PORT=4000
# Orígenes permitidos para CORS (separados por coma). Si la API va detrás de /api
# en el mismo dominio, basta con el dominio del sitio.
CORS_ORIGINS=https://www.actuarialfactor.com,https://actuarialfactor.com,http://localhost:5500,http://127.0.0.1:5500
SITE_URL=https://www.actuarialfactor.com
# true si corre detrás de Apache/Nginx (reverse proxy) para obtener la IP real
TRUST_PROXY=true

# ---------- MySQL ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=actuarial_user
DB_PASSWORD=change-me
DB_NAME=actuarialfactor
DB_CONNECTION_LIMIT=10

# ---------- Sesiones del admin (SAW) ----------
# Cookie HttpOnly con token aleatorio; el hash se guarda en la tabla sessions
SESSION_TTL_HOURS=8
SESSION_IDLE_MINUTES=120
# true en producción (HTTPS). En http://localhost debe ser false
SESSION_SECURE_COOKIE=true
# Adónde manda el login a usuarios admin/editor
#   producción: /SAW/   ·   desarrollo: http://localhost:4000/SAW/
ADMIN_URL=/SAW/

# ---------- Rutas del sitio (relativas a back/api) ----------
FRONT_DIR=../../front
SAW_DIR=../../front/SAW
UPLOADS_DIR=../../front/uploads
I18N_DIR=../../front/i18n
BACKUPS_DIR=./storage/backups
UPLOAD_MAX_MB=25

# ---------- Email (Nodemailer transporter) ----------
SMTP_HOST=mail.actuarialfactor.com
SMTP_PORT=465
# true para 465 (SSL), false para 587 (STARTTLS)
SMTP_SECURE=true
SMTP_USER=no-reply@actuarialfactor.com
SMTP_PASSWORD=change-me
MAIL_FROM="Actuarial Factor <no-reply@actuarialfactor.com>"
# Destinatario(s) interno(s) de notificaciones (separados por coma)
MAIL_NOTIFY_TO=info@actuarialfactor.com
# true = no envía, solo escribe el correo en consola (desarrollo)
MAIL_DRY_RUN=false

# ---------- Repositorio de archivos (rol uploader) ----------
# local = archivos en el servidor (storage/repository) · onedrive = Microsoft OneDrive vía Graph
REPO_DRIVER=local
REPO_MAX_MB=100
REPO_LOCAL_DIR=./storage/repository

# ---------- OneDrive (Microsoft Graph) — requerido si REPO_DRIVER=onedrive ----------
# app       = OneDrive for Business / SharePoint (Microsoft 365). Permiso de APLICACIÓN
#             Files.ReadWrite.All (o Sites.Selected) con consentimiento de administrador.
# delegated = OneDrive personal (outlook/hotmail). Permisos DELEGADOS Files.ReadWrite +
#             offline_access; un admin conecta la cuenta una vez desde SAW › Repositorio.
ONEDRIVE_AUTH=app
ONEDRIVE_TENANT_ID=
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
# Destino (modo app), uno de los tres: Drive ID, Site ID de SharePoint o el usuario dueño del OneDrive
ONEDRIVE_DRIVE_ID=
ONEDRIVE_SITE_ID=
ONEDRIVE_USER=
# Carpeta raíz dentro del OneDrive (se crea sola)
ONEDRIVE_ROOT_FOLDER=ActuarialFactor/Repositorio
# Solo modo delegated: URL registrada en la app de Azure y llave para cifrar el refresh token
#   ONEDRIVE_REDIRECT_URI=https://www.actuarialfactor.com/api/repository/onedrive/callback
#   generar llave: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ONEDRIVE_REDIRECT_URI=
ONEDRIVE_TOKEN_KEY=
